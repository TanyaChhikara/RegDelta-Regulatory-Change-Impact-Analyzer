# =============================================================================
# RegDelta - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# =============================================================================

# --- LLM API Keys ---
# At least one is required. Anthropic recommended for primary reasoning.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- Embedding Model ---
# Options: "openai" (API, costs money) or "local" (free, needs GPU)
EMBEDDING_PROVIDER=openai
# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regdelta
POSTGRES_USER=regdelta
POSTGRES_PASSWORD=change-me-in-production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Observability (optional, add later) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# --- RBI Data Source ---
# User-Agent for HTTP requests to rbi.org.in (be a good citizen)
RBI_USER_AGENT=RegDelta/0.1 (research project; contact@example.com)
# Rate limit: max requests per second to rbi.org.in
RBI_RATE_LIMIT=2
